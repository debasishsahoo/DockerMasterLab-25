# Backend Configuration
APP_NAME=DockerTeachingApp
APP_ENV=production
APP_DEBUG=false
APP_VERSION=1.0.0

# Database
DB_CONNECTION=postgres
DB_HOST=db
DB_PORT=5432
DB_DATABASE=docker_teaching_prod
DB_USERNAME=prod_admin

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Security
JWT_ALGORITHM=HS256
JWT_EXPIRATION=3600
CORS_ORIGIN=https://example.com

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FORMAT=json